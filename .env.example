# ============================================================
# AptiMet Trainee Portal — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# PostgreSQL connection string (REQUIRED by API server + scripts)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Local dev example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aptimet

# Replit / cloud postgres example (supplied automatically by Replit DB):
# DATABASE_URL=postgresql://replit:<token>@<host>:5432/<db>

# API server port (REQUIRED by artifacts/api-server — default: 5000)
PORT=5000

# Node environment (used by service-worker registration guard in frontend)
NODE_ENV=development
